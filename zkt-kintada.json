 "blocks": [
  {
   "id": "zkt-kintada-0001",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "卷",
   "author": "",
   "text": "が百敷にかはらぬ物は梅の花折りてかざせる匂也けり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0002",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "枇杷のおとヾ左大臣になり給へる御よろこびにおほき大臣わたらせ給へる口御あるじありてかはらけたび〓〓になりてあるじもまらうども歌よみ給ふに",
   "author": "",
   "text": "色も香も今年の春は梅の花二たび匂ふ心ちこぞすれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0003",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "紅にゆきゝの程は遠けれど梅のうへには通ふべら也",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0004",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "朱雀院の御かどのわらはにおはしましける時膝の上に御手づから梅の花をかうぶりに挿させ給ひてかしらもたげざらむさきに歌よめと仰せられければおきあがるまヽに",
   "author": "",
   "text": "百百の梅の花笠さす時は天の下こそうしろやすけれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0005",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "南殿の御前の櫻の花の散るをみて",
   "author": "",
   "text": "ch殿殿のともの御奴心あらばこの春ばかり朝〓めすな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0006",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "延長八年三月二十三口藤壺の藤の賀に",
   "author": "",
   "text": "一色深く匂へる藤の花故に殘りすくなき春をこそ思へ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0007",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "夏延喜の御時四月一日爲の鳴かぬ年の歌仕うまつれと仰せらるゝに",
   "author": "",
   "text": "一春は唯昨日ばかりを爲の限れる〓とも鳴かぬ今日かな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0008",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "北の宮のみぐしあげの屏風に山を越ゆる人の郭公を聞きたる所に",
   "author": "",
   "text": "〓行きやらで山路暮しつ時鳥今一聲の聞かまほしさに",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0009",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "綻びて招く袂と見えしかばしどけなしとて我ぞ結し",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0010",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "池水のも中に出て遊ぶ魚の數さへ見ゆる秋の夜の月",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0011",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓〓夜の月とはよそに聞つれど時にあへるは今宵也見",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0012",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "いいささらば今日あすへなむ秋の空今幾日かは野べに殘らじ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0013",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "ハ月影の田上川に〓ければ網代にひをのよるも見え見",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0014",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "か流來る紅葉の色の紅ければ網代にひをの寄も見え見",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0015",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "冬延喜十七年十月五月藤壺の尙侍の御屏風の歌",
   "author": "",
   "text": "00神無月時雨に增る菊の花秋はてにきと見えずも有哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0016",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "延喜の御時菊の宴に霜の中の菊を惜むといふ心をよめる歌二つ、一つは人の爲に",
   "author": "",
   "text": "。厭しき霜にも有哉菊の花移ろふとやは色を見すべき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0017",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "co置霜に色染め返し匂ひつゝ花の盛は今日ながら見む",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0018",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "寬平の御時の歌合に",
   "author": "",
   "text": "∞の梅が枝に降積む雪は一年に二度咲ける花かとぞ見る",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0019",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "八條の大將めの爲にかしけるに",
   "author": "",
   "text": "。〇代代ななほこそあかね君がため思ふ心の限なければ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0020",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "きさいの宮の御屏風に",
   "author": "",
   "text": "100返返り舟路は痛く馴にけり年を積てぞ運ぶべらなる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0021",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "北の宮の御もぎに",
   "author": "",
   "text": "x皆皆のいかでと思ふ萬代の例に君をいのる今日かな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0022",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "女の許に",
   "author": "",
   "text": "〓〓ふふとをよゝに傅へる吳竹の節の數なき戀もする哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0023",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓思やる心は常に通へども逢坂の關越えずもあるかな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0024",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "承平五年十二月五日から物の使藏人左衞門尉藤原親成術が餞",
   "author": "",
   "text": "加別るゝか侘しき物はいつしかと逢見むとを思ふ也見",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0025",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "あがたへ行く女にさうぞくやるとて",
   "author": "",
   "text": "。いとせめて戀しき旅の唐衣程へて返す人もあらなむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0026",
   "pid": "873676",
   "pages": [
    10
   ],
   "no": null,
   "kotobagaki": "田舍へくだる人のもとに白き袋を靑きものしてすりて火打を入れてやるとて",
   "author": "",
   "text": "一打見ては思出でよと我宿の蒸草して摺れるなりけり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0027",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一月讀の天に昇て間もなく明らけき夜を見るが樂しき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0028",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "小野好古純友がうての使に下りての翌る年少將分にて四位なるべかりけるいかなるにか漏されたりける山いひやりける文の中に書き付けゝる",
   "author": "",
   "text": "一五匣二年あはぬ君が身を明け乍らやはあはむと思し",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0029",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "延喜の御時月の雨白かりける夜殿局など廻りて御覽じける御件にたゞ一人候ひけるに誰とも知〓らぬ女の一人いでゐていみじう泣くがありけるを上も怪しがらせ給ひて寄りてとへと仰せられければ寄りて問へど物も云はざりしかば",
   "author": "",
   "text": "思ふらむ心の內は知らね共泣くを見るこそ哀也けれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0030",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "同じ御時五位の戚人なりしを位去らせ給ひしかば平組のさうぞくになりて參りたりしを見てといふを聞きて近江の守になりて下るに貫之が許よりおこせたる歌二つ返し",
   "author": "",
   "text": "大關の戶ぞ驚かれける君が爲心とヾめぬ時はなけれど",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0031",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "湖に潮たるばかりをさなくて都に年の老いにける哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0032",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "天慶八年內の屏風に",
   "author": "",
   "text": "んながるれど世をへて盡ぬ汀こそ千年の鶴の栖也けれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0033",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "延喜の御時殿上の人々おのが名をはへて歌よみけるに",
   "author": "",
   "text": "な所衣脫捨てがたを我やきむ唯眼の前にかけて社見め",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0034",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "同じ五年八月十五夜",
   "author": "",
   "text": "〓古もあらじとぞ思ふ秋の夜の月の例は今宵なりけり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0035",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一おり昇り見かひもなし白雲の山と賴し君も見えねば",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0036",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "此の歌延喜の帝かくれさせ給ひて殿上もせざりける程に山に雪の降りかゝれるを見て詠める九月つごもりの程に紅葉見むとてと山の方にあるきてかもんのすけとありければ民部丞千古中宮の御屏風に海のうへゆく舟書けるところに",
   "author": "",
   "text": "一春の日の長閑き浦に消舟は水底さへぞ靜けかりける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0037",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "八月十五夜",
   "author": "",
   "text": "暮るゝ共思ほえぬ哉雲の上に影わき難き秋の夜の月",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0038",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一月每にある月なれどよをへつゝ今宵に勝る影なかリ見",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0039",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "七夕",
   "author": "",
   "text": "和稀にのみ逢ふとはすれど天河流れて絶む物にし有ねば",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0040",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "小鷹狩",
   "author": "",
   "text": "秋の野に色々咲ける花見れば歸らむ程ぞいつと知られぬ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0041",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓移るはむ色を見よとて菊の花露の心もおける也けり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0042",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "た草田にて秋よりとほに見りしかど程へにけれに刈積て〓",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0043",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "collenaを網代によする物ならに紅葉の色は赤くみてきし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0044",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "ミまづ散て後に咲ぬる梅の花思ひ惑ふは雪にざりける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0045",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "我宿に松と竹との微りせば千年てふ〓と外にぞ有まし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0046",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "1色を見て且惑はせる梅の花香をふり際す雪無りけり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0047",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓ににみみ年はあらなむ荒小田を返す〓〓も花を見べく",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-kintada-0048",
   "pid": "873676",
   "pages": [
    11
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "古〓はふりやしぬらむ時鳥夜ふかき聲の珍しきかな",
   "sachu": "",
   "poems": [],
